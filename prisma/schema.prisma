// Cue - Prisma schema
// Multi-client social media scheduler (LinkedIn + Instagram MVP)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Workspaces (tenants) - every user + client belongs to exactly one
// ---------------------------------------------------------------------------

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // Set by the platform admin panel (src/app/admin). Defaults leave every
  // workspace exactly as it was: no limits, every feature on, not suspended.
  plan             Plan      @default(UNLIMITED)
  disabledFeatures String[]  @default([]) // feature keys from src/lib/plans.ts
  suspendedAt      DateTime? // set = members locked out, API refused, nothing publishes
  suspendedReason  String?

  users   User[]
  clients Client[]
  apiKeys ApiKey[]
  storage StorageConfig?
}

// Limits for each plan live in src/lib/plans.ts.
enum Plan {
  FREE
  PRO
  AGENCY
  UNLIMITED
}

// A workspace's own bucket for media uploads ("bring your own storage"). One
// per workspace; when there is none, uploads go to Cue's default R2 bucket
// (the R2_* env vars). Saved only after a live test passes, so a broken
// config can't quietly break uploads or publishing.
model StorageConfig {
  id              String          @id @default(cuid())
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId     String          @unique
  provider        StorageProvider
  accountId       String? // R2: the Cloudflare account ID
  jurisdiction    String? // R2: null (default), "eu" or "fedramp"
  endpoint        String? // S3: the API endpoint; null means AWS S3 itself
  region          String // "auto" for R2
  bucket          String
  forcePathStyle  Boolean         @default(false)
  accessKeyId     String
  secretAccessKey String // encrypted (src/lib/crypto.ts); never sent to the browser
  publicUrl       String // base URL objects are publicly readable at, no trailing slash
  verifiedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

enum StorageProvider {
  R2
  S3
}

// ---------------------------------------------------------------------------
// Team / auth
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      Role     @default(MANAGER)
  createdAt DateTime @default(now())

  lastSeenAt   DateTime? // last request in the app, written at most every few minutes
  bannedAt     DateTime? // set = this person can't use Cue at all
  bannedReason String?

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String

  posts    Post[]
  comments Comment[]
  apiKeys  ApiKey[]
}

enum Role {
  ADMIN
  MANAGER
}

// Bearer tokens for the programmatic API (/api/v1). The key itself is shown
// once at creation and never stored: we keep only its sha256, which is safe for
// a 256-bit random secret and lets a request look its key up by exact hash.
model ApiKey {
  id          String    @id @default(cuid())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String // the key acts as this user; becomes Post.authorId
  name        String
  prefix      String // first 12 chars, for display only
  hash        String    @unique // sha256 of the full key; the key itself is never stored
  lastUsedAt  DateTime?
  useCount    Int       @default(0) // successful authentications, for usage
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Clients (workspaces) + connected social accounts
// ---------------------------------------------------------------------------

model Client {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  color     String?  @default("#2A6FF2")
  createdAt DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  accounts        SocialAccount[]
  posts           Post[]
  automationRules AutomationRule[]
}

model SocialAccount {
  id           String    @id @default(cuid())
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId     String
  platform     Platform
  displayName  String
  externalId   String // LinkedIn org URN / IG business account id
  accessToken  String // encrypted at rest
  refreshToken String? // encrypted at rest
  tokenExpires DateTime?
  scopes       String?
  createdAt    DateTime  @default(now())

  // Instagram comment automations (src/lib/automations). When Cue subscribed
  // the account to Meta's comment webhooks, and when it last read its comments
  // itself (the every-minute check that stands in until webhooks are approved).
  webhooksSubscribedAt DateTime?
  commentsCheckedAt    DateTime?

  targets         PostTarget[]
  automationRules AutomationRule[]

  @@unique([clientId, platform, externalId])
}

enum Platform {
  LINKEDIN
  INSTAGRAM
  YOUTUBE
}

// ---------------------------------------------------------------------------
// Posts + per-account publish targets + media
// ---------------------------------------------------------------------------

model Post {
  id                String         @id @default(cuid())
  client            Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId          String
  author            User           @relation(fields: [authorId], references: [id])
  authorId          String
  body              String
  firstComment      String? // posted under the live post (YouTube/Instagram) by the publish sweep
  title             String? // YouTube video title (unused by LinkedIn/Instagram)
  youtubePrivacy    String? // YouTube visibility: public | unlisted | private (null for non-YT)
  youtubeTags       String[]       @default([]) // YouTube tags, cleaned + within the 500-char budget
  youtubeCategoryId String? // YouTube category id; null means the adapter default (22)
  // Set by API callers via the Idempotency-Key header so a retried request
  // returns the original post instead of publishing a second copy.
  idempotencyKey    String?
  scheduledAt       DateTime?
  status            PostStatus     @default(DRAFT)
  approval          ApprovalStatus @default(APPROVED)
  // LinkedIn-only content types (null = a normal text/media post):
  link              Json? // { url, title, description } - link-preview post
  poll              Json? // { question, options: string[], duration } - poll post
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  media           MediaAsset[]
  targets         PostTarget[]
  comments        Comment[]
  automationRules AutomationRule[]

  // Postgres treats NULLs as distinct, so posts made without a key never clash.
  @@unique([clientId, idempotencyKey])
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIAL
  FAILED
}

// Client/internal approval state. Defaults to APPROVED so posts publish
// unless someone explicitly puts them into review.
enum ApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

model PostTarget {
  id             String        @id @default(cuid())
  post           Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId         String
  account        SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId      String
  platform       Platform
  status         TargetStatus  @default(SCHEDULED)
  bodyOverride   String?
  publishedAt    DateTime?
  externalPostId String?
  permalink      String?
  error          String?
  attempts       Int           @default(0)
  claimedAt      DateTime? // when a publisher run last took it; how "stuck" is judged

  // The post's first comment, once this target is PUBLISHED. A comment never
  // changes the publish status above.
  commentId       String? // the platform's id (YouTube: the comment thread)
  commentError    String?
  commentAttempts Int       @default(0)
  commentedAt     DateTime?
}

enum TargetStatus {
  SCHEDULED
  PROCESSING
  PUBLISHED
  FAILED
}

model MediaAsset {
  id         String    @id @default(cuid())
  post       Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     String
  type       MediaType
  url        String // public URL in the workspace's storage (Cue's R2 or its own bucket)
  storageKey String // R2 object key (deleted on cleanup)
  title      String? // display filename, used for DOCUMENT posts
  sizeBytes  Int? // as declared at upload; null for media uploaded before this was recorded
  createdAt  DateTime  @default(now())
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

model Comment {
  id        String   @id @default(cuid())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  body      String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Permanent lightweight history - no FK to Post, so it outlives deleted posts
// ---------------------------------------------------------------------------

model PostHistory {
  id             String    @id @default(cuid())
  // Denormalized tenant id (PostHistory has no FK to Client - it outlives it).
  workspaceId    String
  clientId       String
  clientName     String
  platform       Platform
  externalPostId String
  permalink      String?
  publishedAt    DateTime
  // compact metrics only (optional, for future analytics)
  likes          Int?
  comments       Int?
  reach          Int?
  clicks         Int?
  lastSyncedAt   DateTime?
}

// ---------------------------------------------------------------------------
// Instagram comment automations (src/lib/automations)
// ---------------------------------------------------------------------------

// "Comment LINK and we'll DM it to you": when a comment on one of the
// account's posts matches, Cue replies to the comment publicly and sends the
// commenter a private reply (Instagram's one DM per comment). Hidden behind
// NEXT_PUBLIC_IG_AUTOMATIONS until Meta grants comment and message access.
model AutomationRule {
  id          String        @id @default(cuid())
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  account     SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId   String
  name        String
  enabled     Boolean       @default(true)
  // Only comments made after this count. Reset when the rule is switched back
  // on, so it doesn't DM everyone who commented while it was off.
  activeSince DateTime      @default(now())

  // ANY_POST watches every post. ONE_POST watches mediaId, which is either
  // picked from the account's posts or filled in when `post` (a Cue post that
  // hadn't published yet) goes live. SetNull, not Cascade: retention or a
  // user deleting the Cue post must not delete a rule that's already working.
  scope          AutomationScope @default(ANY_POST)
  mediaId        String?
  mediaPermalink String?
  mediaCaption   String?
  mediaThumbUrl  String?
  post           Post?           @relation(fields: [postId], references: [id], onDelete: SetNull)
  postId         String?

  keywords      String[]     @default([]) // lowercased; empty only for ANY_COMMENT
  matchMode     KeywordMatch @default(WORD)
  // A rule does one or both: a public reply and a DM. {username} in either
  // becomes the commenter's handle.
  replies       String[]     @default([]) // public reply variants, one picked at random; empty = no public reply
  dmText        String? // null = no DM
  dmButtonLabel String? // optional link button under the DM
  dmButtonUrl   String?
  oncePerPerson Boolean      @default(true)

  // Lifetime totals. The per-comment log below is deleted after 30 days.
  matchedCount    Int       @default(0)
  dmSentCount     Int       @default(0)
  replyCount      Int       @default(0)
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  runs AutomationRun[]

  @@index([accountId])
}

enum AutomationScope {
  ANY_POST
  ONE_POST
}

enum KeywordMatch {
  WORD // the keyword as a whole word or phrase: "link" matches "LINK please", not "linked"
  CONTAINS // anywhere in the comment
  ANY_COMMENT // every comment, no keyword
}

// One comment a rule acted on. commentId is unique because Instagram allows a
// single private reply per comment, and Meta re-sends webhooks for up to 36 h.
model AutomationRun {
  id                String              @id @default(cuid())
  rule              AutomationRule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleId            String
  commentId         String              @unique
  mediaId           String
  commenterId       String // Instagram-scoped id
  commenterUsername String?
  commentText       String
  commentedAt       DateTime
  source            AutomationSource
  status            AutomationRunStatus @default(QUEUED)
  // Each part is done once it has an id or an error. The errors are final;
  // a failure that's worth retrying goes in lastError and the run stays QUEUED.
  replyId           String?
  replyError        String?
  dmMessageId       String?
  dmError           String?
  lastError         String?
  attempts          Int                 @default(0)
  // QUEUED runs are taken when this has passed (null = right away). Taking a
  // run pushes it forward, so two workers can't send the same DM.
  nextAttemptAt     DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([ruleId, commenterId])
  @@index([status, nextAttemptAt])
  @@index([createdAt])
}

enum AutomationSource {
  WEBHOOK
  POLL
}

enum AutomationRunStatus {
  QUEUED // waiting to send, or to retry
  SENT // the DM went, and the public reply too when the rule has one
  PARTIAL // one of the two went
  FAILED
  SKIPPED // this person already got this rule's DM
}

// ---------------------------------------------------------------------------
// Platform administration (src/app/admin)
// ---------------------------------------------------------------------------

// Every action taken in the admin panel. No foreign keys on purpose: the log
// must outlive the workspaces, users and posts it describes.
model AdminAuditLog {
  id          String   @id @default(cuid())
  actorEmail  String
  action      String // e.g. "workspace.suspend"
  targetType  String // workspace | user | post | apiKey | account | storage | platform
  targetId    String?
  workspaceId String?
  reason      String?
  details     Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([workspaceId])
}

// One row ("global") of platform-wide switches.
model PlatformSettings {
  id               String    @id @default("global")
  publishingPaused Boolean   @default(false)
  pausedReason     String?
  announcement     String? // shown to every signed-in user while set
  announcementTone String    @default("info") // info | warning
  announcementAt   DateTime? // changes when the text changes, so dismissals reset
  updatedBy        String?
  updatedAt        DateTime  @updatedAt
}

// The last run of each scheduled job, so the admin panel can tell whether the
// publisher (Supabase pg_cron, every 5 minutes) is actually running.
model CronHeartbeat {
  name      String   @id // "publish"
  lastRunAt DateTime
  ok        Boolean
  summary   Json?
  error     String?
}
