// Cue - Prisma schema
// Multi-client social media scheduler (LinkedIn + Instagram MVP)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Workspaces (tenants) - every user + client belongs to exactly one
// ---------------------------------------------------------------------------

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // Set by the platform admin panel (src/app/admin). Defaults leave every
  // workspace exactly as it was: no limits, every feature on, not suspended.
  plan             Plan      @default(UNLIMITED)
  disabledFeatures String[]  @default([]) // feature keys from src/lib/plans.ts
  suspendedAt      DateTime? // set = members locked out, API refused, nothing publishes
  suspendedReason  String?

  // Home workspace of each User (their active one; see User.workspaceId).
  users       User[]
  // Everyone who belongs here, with their role. The source of truth.
  memberships Membership[]
  invites     Invite[]
  clients     Client[]
  apiKeys     ApiKey[]
  storage     StorageConfig?
}

// Limits for each plan live in src/lib/plans.ts.
enum Plan {
  FREE
  PRO
  AGENCY
  UNLIMITED
}

// A workspace's own bucket for media uploads ("bring your own storage"). One
// per workspace; when there is none, uploads go to Cue's default R2 bucket
// (the R2_* env vars). Saved only after a live test passes, so a broken
// config can't quietly break uploads or publishing.
model StorageConfig {
  id              String          @id @default(cuid())
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId     String          @unique
  provider        StorageProvider
  accountId       String? // R2: the Cloudflare account ID
  jurisdiction    String? // R2: null (default), "eu" or "fedramp"
  endpoint        String? // S3: the API endpoint; null means AWS S3 itself
  region          String // "auto" for R2
  bucket          String
  forcePathStyle  Boolean         @default(false)
  accessKeyId     String
  secretAccessKey String // encrypted (src/lib/crypto.ts); never sent to the browser
  publicUrl       String // base URL objects are publicly readable at, no trailing slash
  verifiedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

enum StorageProvider {
  R2
  S3
}

// ---------------------------------------------------------------------------
// Team / auth
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      Role     @default(MANAGER)
  createdAt DateTime @default(now())

  lastSeenAt   DateTime? // last request in the app, written at most every few minutes
  bannedAt     DateTime? // set = this person can't use Cue at all
  bannedReason String?
  emailAlerts  Boolean   @default(true) // alerts in src/lib/alerts.ts (admins only)

  // The workspace this person is working in right now (switching changes it),
  // so every query scoped by user.workspaceId follows the switcher. Access
  // itself comes from Membership: auth refuses a workspace without one.
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String

  memberships Membership[]
  invitesSent Invite[]     @relation("InvitesSent")
  posts       Post[]
  comments    Comment[]
  apiKeys     ApiKey[]
  oauthCodes  OAuthCode[]
  oauthGrants OAuthGrant[]
}

enum Role {
  ADMIN
  MANAGER
}

// Who belongs to which workspace, and as what. One person can be in several
// workspaces (a freelancer for two agencies); User.role mirrors the role in
// the active one.
model Membership {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  role        Role      @default(MANAGER)
  createdAt   DateTime  @default(now())

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// An invitation to join a workspace, sent by email. The link carries a random
// token: we keep its sha256 to look it up and an encrypted copy so the team
// page can show the link again. Joining needs a signed-in Accept, so a mail
// scanner opening the link can't accept on anyone's behalf.
model Invite {
  id          String    @id @default(cuid())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  email       String // lowercased
  role        Role      @default(MANAGER)
  tokenHash   String    @unique
  tokenEnc    String
  invitedBy   User?     @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedById String?
  createdAt   DateTime  @default(now())
  lastSentAt  DateTime?
  expiresAt   DateTime
  acceptedAt  DateTime?
  declinedAt  DateTime?
  revokedAt   DateTime?

  @@index([email])
  @@index([workspaceId])
}

// Bearer tokens for the programmatic API (/api/v1). The key itself is shown
// once at creation and never stored: we keep only its sha256, which is safe for
// a 256-bit random secret and lets a request look its key up by exact hash.
model ApiKey {
  id          String    @id @default(cuid())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String // the key acts as this user; becomes Post.authorId
  name        String
  prefix      String // first 12 chars, for display only
  hash        String    @unique // sha256 of the full key; the key itself is never stored
  lastUsedAt  DateTime?
  useCount    Int       @default(0) // successful authentications, for usage
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Clients (workspaces) + connected social accounts
// ---------------------------------------------------------------------------

model Client {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  color     String?  @default("#2A6FF2")
  createdAt DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  accounts        SocialAccount[]
  posts           Post[]
  automationRules AutomationRule[]
  leads           Lead[]
  bioPage         BioPage?
}

model SocialAccount {
  id           String    @id @default(cuid())
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId     String
  platform     Platform
  displayName  String
  externalId   String // LinkedIn org URN / IG business account id
  accessToken  String // encrypted at rest
  refreshToken String? // encrypted at rest
  tokenExpires DateTime?
  scopes       String?
  createdAt    DateTime  @default(now())

  // Instagram comment automations (src/lib/automations). When Cue subscribed
  // the account to Meta's comment webhooks, and when it last read its comments
  // itself (the every-minute check that stands in until webhooks are approved).
  webhooksSubscribedAt DateTime?
  commentsCheckedAt    DateTime?
  inboxSyncedAt        DateTime? // Reply Desk's last read of this account's comments

  targets         PostTarget[]
  automationRules AutomationRule[]
  leads           Lead[]
  inboxComments   InboxComment[]
  bioPages        BioPage[]

  @@unique([clientId, platform, externalId])
}

enum Platform {
  LINKEDIN
  INSTAGRAM
  YOUTUBE
}

// ---------------------------------------------------------------------------
// Posts + per-account publish targets + media
// ---------------------------------------------------------------------------

model Post {
  id                String         @id @default(cuid())
  client            Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId          String
  author            User           @relation(fields: [authorId], references: [id])
  authorId          String
  body              String
  firstComment      String? // posted under the live post (YouTube/Instagram) by the publish sweep
  title             String? // YouTube video title (unused by LinkedIn/Instagram)
  youtubePrivacy    String? // YouTube visibility: public | unlisted | private (null for non-YT)
  youtubeTags       String[]       @default([]) // YouTube tags, cleaned + within the 500-char budget
  youtubeCategoryId String? // YouTube category id; null means the adapter default (22)
  // Set by API callers via the Idempotency-Key header so a retried request
  // returns the original post instead of publishing a second copy.
  idempotencyKey    String?
  scheduledAt       DateTime?
  status            PostStatus     @default(DRAFT)
  approval          ApprovalStatus @default(APPROVED)
  // LinkedIn-only content types (null = a normal text/media post):
  link              Json? // { url, title, description } - link-preview post
  poll              Json? // { question, options: string[], duration } - poll post
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  media           MediaAsset[]
  targets         PostTarget[]
  comments        Comment[]
  automationRules AutomationRule[]

  // Postgres treats NULLs as distinct, so posts made without a key never clash.
  @@unique([clientId, idempotencyKey])
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIAL
  FAILED
}

// Client/internal approval state. Defaults to APPROVED so posts publish
// unless someone explicitly puts them into review.
enum ApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

model PostTarget {
  id             String        @id @default(cuid())
  post           Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId         String
  account        SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId      String
  platform       Platform
  status         TargetStatus  @default(SCHEDULED)
  bodyOverride   String?
  publishedAt    DateTime?
  externalPostId String?
  permalink      String?
  error          String?
  attempts       Int           @default(0)
  claimedAt      DateTime? // when a publisher run last took it; how "stuck" is judged

  // The post's first comment, once this target is PUBLISHED. A comment never
  // changes the publish status above.
  commentId       String? // the platform's id (YouTube: the comment thread)
  commentError    String?
  commentAttempts Int       @default(0)
  commentedAt     DateTime?
}

enum TargetStatus {
  SCHEDULED
  PROCESSING
  PUBLISHED
  FAILED
}

model MediaAsset {
  id         String    @id @default(cuid())
  post       Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     String
  type       MediaType
  url        String // public URL in the workspace's storage (Cue's R2 or its own bucket)
  storageKey String // R2 object key (deleted on cleanup)
  title      String? // display filename, used for DOCUMENT posts
  sizeBytes  Int? // as declared at upload; null for media uploaded before this was recorded
  createdAt  DateTime  @default(now())
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

model Comment {
  id        String   @id @default(cuid())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  body      String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Permanent lightweight history - no FK to Post, so it outlives deleted posts
// ---------------------------------------------------------------------------

model PostHistory {
  id             String    @id @default(cuid())
  // Denormalized tenant id (PostHistory has no FK to Client - it outlives it).
  workspaceId    String
  clientId       String
  clientName     String
  platform       Platform
  externalPostId String
  permalink      String?
  publishedAt    DateTime
  // compact metrics only (optional, for future analytics)
  likes          Int?
  comments       Int?
  reach          Int?
  clicks         Int?
  lastSyncedAt   DateTime?
}

// ---------------------------------------------------------------------------
// Instagram comment automations (src/lib/automations)
// ---------------------------------------------------------------------------

// "Comment LINK and we'll DM it to you": when a comment on one of the
// account's posts matches, Cue replies to the comment publicly and sends the
// commenter a private reply (Instagram's one DM per comment). A rule can also
// start from a story reply or a DM, gate the link behind a follow, and ask for
// an email or phone number first. Hidden behind NEXT_PUBLIC_IG_AUTOMATIONS
// until Meta grants comment and message access.
model AutomationRule {
  id          String            @id @default(cuid())
  client      Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  account     SocialAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId   String
  name        String
  enabled     Boolean           @default(true)
  // What starts it: a comment (watching `scope` below), a reply to any story,
  // or a DM. Story replies and DMs open Instagram's 24-hour window, so those
  // rules answer with normal messages instead of a private reply.
  trigger     AutomationTrigger @default(COMMENT)
  // Only comments made after this count. Reset when the rule is switched back
  // on, so it doesn't DM everyone who commented while it was off.
  activeSince DateTime          @default(now())

  // ANY_POST watches every post. ONE_POST watches mediaId, which is either
  // picked from the account's posts or filled in when `post` (a Cue post that
  // hadn't published yet) goes live. SetNull, not Cascade: retention or a
  // user deleting the Cue post must not delete a rule that's already working.
  scope          AutomationScope @default(ANY_POST)
  mediaId        String?
  mediaPermalink String?
  mediaCaption   String?
  mediaThumbUrl  String?
  post           Post?           @relation(fields: [postId], references: [id], onDelete: SetNull)
  postId         String?

  keywords      String[]     @default([]) // lowercased; empty only for ANY_COMMENT
  matchMode     KeywordMatch @default(WORD)
  fuzzy         Boolean      @default(true) // tolerate one typo in keywords of 4+ letters
  // A rule does one or both: a public reply and a DM. {username} in either
  // becomes the commenter's handle.
  replies       String[]     @default([]) // public reply variants, one picked at random; empty = no public reply
  dmText        String? // null = no DM
  dmVariants    String[]     @default([]) // other wordings of dmText, rotated every rotateEvery DMs
  rotateEvery   Int          @default(50)
  dmButtonLabel String? // optional link button under the DM
  dmButtonUrl   String?
  oncePerPerson Boolean      @default(true)

  // Steps before the link. Each waits for the person to tap or reply, which
  // opens Instagram's 24-hour messaging window for the next message.
  followGate      Boolean    @default(false) // only followers get the link
  gateText        String? // the first DM, with a "Send me the link" button
  collect         LeadField? // ask for an email or phone number first
  askText         String?
  followUpText    String? // one nudge if they go quiet part-way
  followUpMinutes Int        @default(60)

  // Comments to hold for review instead of answering.
  holdWords    String[] @default([])
  aiModeration Boolean  @default(false) // AI also holds abuse (needs ANTHROPIC_API_KEY)

  // Lifetime totals. The per-comment log below is deleted after 30 days.
  matchedCount    Int       @default(0)
  dmSentCount     Int       @default(0)
  replyCount      Int       @default(0)
  deliveredCount  Int       @default(0) // the link reached them, after any gate or question
  leadCount       Int       @default(0)
  heldCount       Int       @default(0)
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  runs AutomationRun[]

  @@index([accountId])
}

enum AutomationScope {
  ANY_POST
  ONE_POST
}

enum AutomationTrigger {
  COMMENT
  STORY_REPLY
  DM_KEYWORD
}

enum LeadField {
  EMAIL
  PHONE
}

enum KeywordMatch {
  WORD // the keyword as a whole word or phrase: "link" matches "LINK please", not "linked"
  CONTAINS // anywhere in the comment
  ANY_COMMENT // every comment, no keyword
}

// One comment (or story reply, or DM) a rule acted on. commentId holds the
// comment id, or the message id for story and DM triggers. It's unique because
// Instagram allows a single private reply per comment, and Meta re-sends
// webhooks for up to 36 h.
model AutomationRun {
  id                String              @id @default(cuid())
  rule              AutomationRule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleId            String
  commentId         String              @unique
  trigger           AutomationTrigger   @default(COMMENT)
  mediaId           String? // the post (or story) it came from
  commenterId       String // Instagram-scoped id
  commenterUsername String?
  commentText       String
  commentedAt       DateTime
  source            AutomationSource
  status            AutomationRunStatus @default(QUEUED)
  // Each part is done once it has an id or an error. The errors are final;
  // a failure that's worth retrying goes in lastError and the run stays QUEUED.
  replyId           String?
  replyError        String?
  dmMessageId       String?
  dmError           String?
  lastError         String?
  attempts          Int                 @default(0)
  // QUEUED runs are taken when this has passed (null = right away). Taking a
  // run pushes it forward, so two workers can't send the same DM.
  nextAttemptAt     DateTime?

  // The conversation after the first DM (follow gate, question, follow-up).
  dmSentAt       DateTime? // the first DM went out; pacing counts these per hour
  recipientId    String? // their Instagram-scoped id, for every message after the first
  stage          RunStage  @default(START)
  lastUserAt     DateTime? // their last tap or reply; Instagram allows messages for 24 h after it
  followUpAt     DateTime? // nudge then, if still waiting
  followUpSentAt DateTime?
  deliveredAt    DateTime? // the link went out
  heldReason     String? // why it's HELD (a hold word, or the AI's reason)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ruleId, commenterId])
  @@index([status, nextAttemptAt])
  @@index([recipientId, stage])
  @@index([stage, followUpAt])
  @@index([createdAt])
}

enum RunStage {
  START // nothing sent yet
  WAIT_TAP // sent the gate message, waiting for "Send me the link"
  WAIT_FOLLOW // they tapped but don't follow yet
  WAIT_ANSWER // asked for an email or phone number
  DONE
}

enum AutomationSource {
  WEBHOOK
  POLL
}

enum AutomationRunStatus {
  QUEUED // waiting to send, or to retry
  SENT // the DM went, and the public reply too when the rule has one
  PARTIAL // one of the two went
  FAILED
  SKIPPED // this person already got this rule's DM
  HELD // held for review (hold word or AI); nothing sent
}

// Everyone an automation talked to, per Instagram account. Kept until deleted
// (it's the workspace's list), unlike the 30-day run log; deleting the client
// or disconnecting the account deletes it.
model Lead {
  id         String            @id @default(cuid())
  client     Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId   String
  account    SocialAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId  String
  igsid      String // Instagram-scoped id
  username   String?
  email      String?
  phone      String?
  source     AutomationTrigger
  lastRule   String? // the automation that last reached them, by name
  touches    Int               @default(1)
  createdAt  DateTime          @default(now())
  lastSeenAt DateTime          @default(now())

  @@unique([accountId, igsid])
  @@index([clientId, lastSeenAt])
}

// ---------------------------------------------------------------------------
// Reply Desk (src/lib/reply-desk): recent comments across clients' Instagram
// and YouTube accounts, sorted so real questions come first. Synced by the
// every-minute job; comments older than 30 days are deleted.
// ---------------------------------------------------------------------------

model InboxComment {
  id         String        @id @default(cuid())
  account    SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId  String
  clientId   String
  platform   Platform
  externalId String // the platform's comment id
  mediaId    String
  mediaTitle String? // caption or video title, shortened
  mediaUrl   String?
  author     String?
  authorId   String?
  text       String
  postedAt   DateTime
  kind       CommentKind   @default(OTHER)
  state      InboxState    @default(OPEN)
  replyText  String?
  replyId    String?
  repliedAt  DateTime?
  repliedBy  String?
  createdAt  DateTime      @default(now())

  @@unique([platform, externalId])
  @@index([clientId, state, postedAt])
}

enum CommentKind {
  QUESTION // asks something: price, size, how, when
  OTHER
  NOISE // emoji-only, "nice", tags of friends
  ABUSE
}

enum InboxState {
  OPEN
  REPLIED
  DONE
}

// ---------------------------------------------------------------------------
// Link-in-bio pages (trycue.space/b/<slug>), one per client.
// ---------------------------------------------------------------------------

model BioPage {
  id        String         @id @default(cuid())
  client    Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String         @unique
  slug      String         @unique
  title     String
  bio       String?
  // The Instagram account whose recent posts show as a grid; none, no grid.
  account   SocialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId String?
  links     Json           @default("[]") // [{ id, label, url }]
  postLinks Json           @default("{}") // { [mediaId]: url }: where a grid tile goes instead of the post
  // The grid and profile picture as last read from Instagram (src/lib/bio/grid.ts),
  // so a visit never waits on Instagram. Its image links expire after a few days.
  grid      Json           @default("[]") // [{ id, image, permalink, caption, video }]
  avatarUrl String?
  gridAt    DateTime?
  published Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  clicks BioClick[]
}

// Daily counts per page and target ("view", a link id, or a media id).
model BioClick {
  id     String   @id @default(cuid())
  page   BioPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId String
  target String
  day    DateTime @db.Date
  count  Int      @default(0)

  @@unique([pageId, target, day])
}

// ---------------------------------------------------------------------------
// Email alerts (src/lib/alerts.ts). One row per alert sent, so the same thing
// isn't emailed twice. No foreign keys: it's bookkeeping.
// ---------------------------------------------------------------------------

model AlertLog {
  id          String   @id @default(cuid())
  workspaceId String
  kind        String // spike | failed | expiring
  key         String // what it was about: a rule, post or account id (plus a day for repeats)
  sentAt      DateTime @default(now())

  @@unique([workspaceId, kind, key])
  @@index([sentAt])
}

// ---------------------------------------------------------------------------
// Platform administration (src/app/admin)
// ---------------------------------------------------------------------------

// Every action taken in the admin panel. No foreign keys on purpose: the log
// must outlive the workspaces, users and posts it describes.
model AdminAuditLog {
  id          String   @id @default(cuid())
  actorEmail  String
  action      String // e.g. "workspace.suspend"
  targetType  String // workspace | user | post | apiKey | account | storage | platform
  targetId    String?
  workspaceId String?
  reason      String?
  details     Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([workspaceId])
}

// One row ("global") of platform-wide switches.
model PlatformSettings {
  id               String    @id @default("global")
  publishingPaused Boolean   @default(false)
  pausedReason     String?
  announcement     String? // shown to every signed-in user while set
  announcementTone String    @default("info") // info | warning
  announcementAt   DateTime? // changes when the text changes, so dismissals reset
  siteTheme        String    @default("default") // a key from src/lib/site-themes.ts, on every page
  updatedBy        String?
  updatedAt        DateTime  @updatedAt
}

// The last run of each scheduled job, so the admin panel can tell whether the
// publisher (Supabase pg_cron, every 5 minutes) is actually running.
model CronHeartbeat {
  name      String   @id // "publish" | "mailer" | "automations" | "reply-desk"
  lastRunAt DateTime
  ok        Boolean
  summary   Json?
  error     String?
}

// ---------------------------------------------------------------------------
// The Claude and ChatGPT connector (src/lib/connector): an MCP server at
// /api/mcp, and the OAuth that lets an assistant use it as a member. Apps
// register themselves (RFC 7591), a member approves one on /oauth/authorize,
// and the app swaps the one-time code for tokens. Like API keys, only sha256
// hashes of codes and tokens are stored.
// ---------------------------------------------------------------------------

model OAuthClient {
  id           String   @id @default(cuid()) // the client_id
  name         String // self-reported by the app, so shown beside its redirect host
  redirectUris String[]
  createdAt    DateTime @default(now())

  codes  OAuthCode[]
  grants OAuthGrant[]
}

// A one-time code from the consent screen: 10 minutes, PKCE-bound.
model OAuthCode {
  id            String      @id @default(cuid())
  hash          String      @unique
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  redirectUri   String
  codeChallenge String
  scope         String
  expiresAt     DateTime
  usedAt        DateTime?
  grantId       String? // what it was exchanged for, revoked if the code is replayed
  createdAt     DateTime    @default(now())
}

// One approval: an access token (1 hour) and a refresh token that's replaced
// on every use. Revoking it (Settings) disconnects the app.
model OAuthGrant {
  id             String      @id @default(cuid())
  client         OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId       String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  workspaceId    String
  scope          String
  accessHash     String      @unique
  accessExpires  DateTime
  refreshHash    String      @unique
  refreshExpires DateTime
  revokedAt      DateTime?
  lastUsedAt     DateTime?
  useCount       Int         @default(0)
  createdAt      DateTime    @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Mailer (src/app/admin/mailer): marketing email sent by platform admins to
// contacts they add or import. Separate from the app's own email (sign-in
// codes, invites). Only /admin/mailer, the mailer cron and the public
// unsubscribe page read these tables, so a missing table can't break the app.
// ---------------------------------------------------------------------------

// A Resend account that email goes out from. Use a different Resend account
// from the one that sends sign-in codes, so complaints about marketing email
// can never pause sign-in.
model MailerAccount {
  id             String    @id @default(cuid())
  name           String    @unique
  fromName       String
  fromEmail      String
  replyTo        String?
  apiKey         String // encrypted (src/lib/crypto.ts); never sent to the browser
  webhookSecret  String? // encrypted Resend webhook signing secret (whsec_...)
  perMinute      Int       @default(60)
  perDay         Int       @default(100)
  active         Boolean   @default(true)
  lastVerifiedAt DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  campaigns MailerCampaign[]
}

// Someone to email. One list for the whole mailer; tags make the segments.
model MailerContact {
  id        String   @id @default(cuid())
  email     String   @unique // lowercased
  name      String?
  company   String?
  tags      String[] @default([])
  fields    Json? // extra spreadsheet columns, usable as {{merge}} fields
  source    String   @default("manual") // manual | paste | import
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sends MailerSend[]
}

// Never email these addresses again: unsubscribed, bounced, complained, or
// added by hand. Checked when a campaign is queued and again before each send.
model MailerSuppression {
  email      String   @id // lowercased
  reason     String // unsubscribed | bounced | complained | manual
  campaignId String?
  note       String?
  createdBy  String? // the admin, for manual entries
  createdAt  DateTime @default(now())
}

model MailerTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  subject   String
  preheader String?
  bodyHtml  String
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MailerCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
}

model MailerCampaign {
  id          String               @id @default(cuid())
  name        String
  account     MailerAccount?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId   String?
  subject     String
  preheader   String?
  bodyHtml    String
  // { tags: string[] (any of), excludeTags: string[] }; no tags = everyone
  audience    Json
  status      MailerCampaignStatus @default(DRAFT)
  scheduledAt DateTime?
  // Counts, recomputed from the sends as they change.
  total       Int                  @default(0)
  sent        Int                  @default(0)
  failed      Int                  @default(0)
  skipped     Int                  @default(0)
  delivered   Int                  @default(0)
  bounced     Int                  @default(0)
  complained  Int                  @default(0)
  opened      Int                  @default(0)
  clicked     Int                  @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  createdBy   String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  sends MailerSend[]

  @@index([status, scheduledAt])
}

// One email to one person: the queue and the log in one table. Rows are
// claimed with FOR UPDATE SKIP LOCKED; claimedAt tells a stuck row apart.
model MailerSend {
  id                String         @id @default(cuid())
  campaign          MailerCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId        String
  contact           MailerContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId         String?
  email             String
  name              String?
  vars              Json? // merge values, copied when queued
  status            String         @default("PENDING") // PENDING | SENDING | SENT | FAILED | SKIPPED
  attempts          Int            @default(0)
  nextAttemptAt     DateTime       @default(now())
  claimedAt         DateTime?
  providerMessageId String?        @unique
  error             String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  bouncedAt         DateTime?
  complainedAt      DateTime?
  openedAt          DateTime?
  clickedAt         DateTime?
  createdAt         DateTime       @default(now())

  @@unique([campaignId, email])
  @@index([campaignId, status])
  @@index([status, nextAttemptAt])
}

// Images uploaded for emails, kept in Cue's own bucket under mailer/.
model MailerAsset {
  id          String   @id @default(cuid())
  storageKey  String   @unique
  url         String
  fileName    String
  contentType String
  size        Int
  createdBy   String
  createdAt   DateTime @default(now())
}

// One row ("global"): the mailer's pause switch and footer.
model MailerSettings {
  id            String   @id @default("global")
  paused        Boolean  @default(false)
  footerName    String   @default("Cue")
  footerAddress String? // optional postal address line (needed for US recipients)
  updatedBy     String?
  updatedAt     DateTime @updatedAt
}
